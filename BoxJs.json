        {
            "id": "GoogleCAPTCHA",
            "name": "Google搜索人机验证",
            "keys": [
                "GOOGLE_CAPTCHA"
            ],
            "descs_html": [
                "<h4 align=\"center\">脚本说明以及配置请查看<a href=\"https://raw.githubusercontent.com/NobyDa/Script/master/Surge/JS/Google_CAPTCHA.js\">脚本注释</a></h4>"

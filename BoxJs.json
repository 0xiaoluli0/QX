{
    "id": "xiaoluli.app.sub",
    "name": "自用脚本订阅",
    "description": "该订阅兼容BoxJs以及QX Gallery",
    "author": "@xiaoluli",
    "icon": "https://avatars.githubusercontent.com/u/78784441",
    "repo": "https://github.com/0xiaoluli0/QX",
    "apps": [
        {
          "id": "minis.pingme.checkin",
          "name": "PingMe 签到+视频奖励",
          "keys": [
            "pingme_capture_alias",
            "pingme_video_count",
            "pingme_video_delay",
            "pingme_account_gap",
        "pingme_accounts_v1"
          ],
          "settings": [
            {
              "id": "pingme_capture_alias",
              "name": "抓包账号备注",
              "val": "",
              "type": "text",
              "placeholder": "例如：大号 / 138xxxx",
              "desc": "抓包前先填写此项，则本次抓到的账号将使用该备注名；抓包成功后会自动清空，方便下一个账号填写。留空则按 账号1、账号2… 自动命名。"
            },
            {
              "id": "pingme_video_count",
              "name": "每账号视频奖励次数",
              "val": "5",
              "type": "text",
              "placeholder": "5",
              "desc": "每个账号每次运行观看视频奖励的次数。留空或非法值则默认 5。"
            },
            {
              "id": "pingme_video_delay",
              "name": "视频奖励间隔时间(毫秒)",
              "val": "8000",
              "type": "text",
              "placeholder": "8000",
              "desc": "同一账号两次视频奖励之间的等待时间，单位毫秒。留空或非法值则默认 8000（8秒）。"
            },
            {
              "id": "pingme_account_gap",
              "name": "账号时间间隔(毫秒)",
              "val": "3500",
              "type": "text",
              "placeholder": "3500",
              "desc": "多账号运行时，账号之间的间隔时间，单位毫秒。留空或非法值则默认 3500（3.5秒）。"
            }
          ],
          "author": "@怎么肥事",
          "repo": "https://raw.githubusercontent.com/0xiaoluli0/QX/refs/heads/main/PingMe.js",
          "script": "https://raw.githubusercontent.com/0xiaoluli0/QX/refs/heads/main/PingMe.js",
          "icons": [
            "https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/PingMe.png",
            "https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/PingMe.png"
          ]
        },

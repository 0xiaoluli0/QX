{
    "id": "xiaoluli.app.sub",
    "name": "自用脚本订阅",
    "description": "该订阅兼容BoxJs以及QX Gallery",
    "author": "@xiaoluli",
    "icon": "https://avatars.githubusercontent.com/u/78784441",
    "repo": "https://github.com/0xiaoluli0/QX",
    "apps": [
        {
          "id": "zenmofeishi.pingme.boxjs",
          "name": "PingMe 多账号管理",
          "keys": [
            "pingme_accounts_v1",
            "pingme_next_alias",
            "pingme_max_video",
            "pingme_video_delay_ms",
            "pingme_account_gap_ms"
          ],
          "settings": [
            {
              "id": "pingme_accounts_v1",
              "name": "PingMe 账号库（自动维护）",
              "val": "",
              "type": "textarea",
              "placeholder": "脚本自动写入 JSON。要改已有账号名，可在 accounts 里找到对应账号，把 alias 改成你想要的名字。",
              "desc": "原版账号库 key，仍使用 pingme_accounts_v1，兼容原版已抓账号。定时任务会按 order 顺序逐个执行。清空此项后需要重新逐个账号抓包。"
            },
            {
              "id": "pingme_next_alias",
              "name": "抓包账号备注",
              "val": "",
              "type": "text",
              "placeholder": "例如：heart / 小号B / AppleID尾号1234",
              "desc": "填写后，下一次打开 PingMe 触发 queryBalanceAndBonus 抓包时，会把新增/更新的账号 alias 命名为这里的值。抓完一个账号后记得改成下一个账号名；留空则按原版自动命名账号1、账号2。"
            },
            {
              "id": "pingme_max_video",
              "name": "每账号视频奖励次数",
              "val": "5",
              "type": "number",
              "desc": "默认 5，和原版一致。脚本读取范围限制为 0-20。"
            },
            {
              "id": "pingme_video_delay_ms",
              "name": "视频奖励间隔毫秒",
              "val": "8000",
              "type": "number",
              "desc": "默认 8000ms，和原版一致。脚本读取范围限制为 1000-60000。"
            },
            {
              "id": "pingme_account_gap_ms",
              "name": "账号时间间隔毫秒",
              "val": "3500",
              "type": "number",
              "desc": "默认 3500ms，和原版一致。脚本读取范围限制为 0-60000。"
            }
          ],
          "author": "@ZenMoFeiShi / BoxJs patch by Minis",
          "repo": "https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/PingMe.js",
          "script": "https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/PingMe.js",
          "icons": [
            "https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/PingMe.png",
            "https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/PingMe.png"
          ]
        },
